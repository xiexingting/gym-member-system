<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.mapper.MemberMapper">
    <select id="selectAll" resultType="Member">
        SELECT * FROM member
    </select>

    <!-- ============ 新增插入SQL ============ -->
    <insert id="insert">
        INSERT INTO member(member_name,phone,gender,id_card,register_time,expire_time,member_status,remark)
        VALUES(#{memberName},#{phone},#{gender},#{idCard},#{registerTime},#{expireTime},#{memberStatus},#{remark})
    </insert>

    <!-- ============ 根据ID删除SQL ============ -->
    <delete id="deleteById">
        DELETE FROM member WHERE member_id = #{memberId}
    </delete>
</mapper>
