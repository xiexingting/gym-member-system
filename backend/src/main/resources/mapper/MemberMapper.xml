<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.mapper.MemberMapper">
    <select id="selectAll" resultType="Member">
        SELECT * FROM member
    </select>

    <!-- ============ 新增插入SQL ============ -->
    <insert id="insert">
        INSERT INTO member(member_name,phone,gender,id_card,register_time,expire_time,member_status,remark)
        VALUES(#{memberName},#{phone},#{gender},#{idCard},#{registerTime},#{expireTime},#{memberStatus},#{remark})
    </insert>

    <!-- ============ 根据ID删除SQL ============ -->
    <delete id="deleteById">
        DELETE FROM member WHERE member_id = #{memberId}
    </delete>
    <!-- ============ 根据ID查询单个 ============ -->
    <select id="selectById" resultType="Member">
        SELECT * FROM member WHERE member_id = #{memberId}
    </select>

    <!-- ============ 根据ID修改 ============ -->
    <update id="updateById">
        UPDATE member
        SET member_name = #{memberName},
        phone = #{phone},
        gender = #{gender},
        id_card = #{idCard},
        expire_time = #{expireTime},
        remark = #{remark}
        WHERE member_id = #{memberId}
    </update>

</mapper>


